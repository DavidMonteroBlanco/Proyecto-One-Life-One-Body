<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pasar el header Authorization a PHP (necesario para tokens Bearer)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Pasar x-xsrf-token a PHP (Sanctum)
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Rutas /api/* y /sanctum/* → Laravel gateway
    RewriteCond %{REQUEST_URI} ^/(api|sanctum)(/|$) [NC]
    RewriteRule ^ laravel.php [L,QSA]

    # React SPA — cualquier ruta que no sea un archivo real → index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>