# ══════════════════════════════════════════════════════════
# .env de PRODUCCIÓN para hosting compartido con cPanel
# (LucusHost, Namecheap, Hostinger...)
#
# En el servidor este fichero se llama ".env" (con el punto) y va
# dentro de la carpeta de la aplicación, NUNCA en public_html:
#
#   /home/USUARIO/olob/.env
#
# Rellena todo lo que pone CAMBIAR. Lo que no lo pone ya tiene el
# valor correcto para este tipo de hosting.
#
# Después de cambiar cualquier cosa de aquí, ejecuta en la terminal:
#   cd ~/olob && php artisan config:cache
# ══════════════════════════════════════════════════════════


# ── Aplicación ──────────────────────────────────────────────
APP_NAME="One Life One Body"
APP_ENV=production

# Siempre false en producción: con true, cada error enseña al visitante
# rutas del servidor y trozos de código.
APP_DEBUG=false

# CAMBIAR: se genera en la terminal con
#   cd ~/olob && php artisan key:generate --show
# y se pega aquí entero, con el "base64:" incluido.
APP_KEY=

# CAMBIAR: la dirección de la web, con https y sin barra al final.
APP_URL=https://CAMBIAR.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES


# ── Base de datos (MySQL / MariaDB) ─────────────────────────
# Se crea en cPanel → Bases de datos MySQL. cPanel antepone tu usuario
# al nombre: si creas "olob", se llama "USUARIO_olob". Usa el nombre
# COMPLETO, tal como lo muestra cPanel. El usuario de la base de datos
# tiene que estar AÑADIDO a la base con TODOS los privilegios.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CAMBIAR_olob
DB_USERNAME=CAMBIAR_olob
DB_PASSWORD=CAMBIAR


# ── Correo (SMTP del buzón de LucusHost) ────────────────────
# Crea el buzón en cPanel → Cuentas de correo, y en "Conectar
# dispositivos" verás el servidor y los puertos.
#
# Dos combinaciones válidas, elige UNA:
#   puerto 465 → MAIL_SCHEME=smtps   (recomendado)
#   puerto 587 → MAIL_SCHEME=smtp
MAIL_MAILER=smtp
MAIL_HOST=CAMBIAR.servidor-de-correo.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=CAMBIAR@tudominio.com
MAIL_PASSWORD=CAMBIAR
# Tiene que ser el MISMO buzón de MAIL_USERNAME, o el servidor rechaza
# el envío o lo manda a spam.
MAIL_FROM_ADDRESS=CAMBIAR@tudominio.com
MAIL_FROM_NAME="One Life One Body"

# CAMBIAR: correo del gimnasio que recibe los avisos de reservas de
# pesaje. Admite varios separados por comas. SIN ESTO NO SE AVISA DE
# NINGUNA RESERVA (no da error, simplemente no manda nada).
OLOB_MAIL_AVISOS=CAMBIAR@tudominio.com

# Opcional: copia de cada dieta y entreno que se envía a un cliente.
OLOB_MAIL_COPIA=


# ── Inteligencia artificial (gratis: Groq + Cloudflare) ────
# Primero Groq; si falla o se acaba su cupo gratuito, Cloudflare.
# Con uno de los dos ya funciona; con los dos hay reserva.
# Sin ninguna, los dos chats responden con el teléfono de contacto.
#
# CAMBIAR: https://console.groq.com/keys -> Create API Key
GROQ_API_KEY=
# CAMBIAR: Cloudflare -> AI -> Workers AI -> "Use REST API"
# (ahí salen el Account ID y el botón para crear el token)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Los modelos ya vienen configurados. Solo se tocan si alguno se retira:
# GROQ_MODELOS=llama-3.3-70b-versatile,openai/gpt-oss-120b
# CLOUDFLARE_MODELOS=@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/meta/llama-4-scout-17b-16e-instruct


# ── PDF ─────────────────────────────────────────────────────
# CAMBIAR: la ruta COMPLETA de public_html. Sin esto, los PDF de
# dietas y entrenos dan error. La ves en cPanel arriba a la izquierda
# del Administrador de archivos, o en la terminal con: cd ~/public_html && pwd
DOMPDF_PUBLIC_PATH=/home/CAMBIAR/public_html


# ── Datos del centro (salen en los PDF, correos y el chat) ──
OLOB_NOMBRE="One Life One Body"
OLOB_DIRECCION="C/ de Goya 37, 03502 Benidorm, Alicante"
OLOB_TELEFONO="+34 601 38 72 63"
OLOB_WEB=https://CAMBIAR.com
OLOB_INSTAGRAM=one.life.one.body.benidorm


# ── Funcionamiento interno: NO CAMBIAR ──────────────────────
# Todo en la base de datos: en hosting compartido no hay Redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# "sync": los trabajos se hacen en el momento. En hosting compartido no
# hay un proceso de cola encendido todo el rato; con "database" el
# trabajo se guardaría y no se haría nunca.
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

# Registro de errores en storage/logs, un fichero por día, 14 días.
# Ahí es donde hay que mirar si algo falla. "notice" guarda los fallos
# y los avisos (por ejemplo, cuando la IA está saturada) pero no cada
# consulta que sale bien, para que el disco no se llene.
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=notice
